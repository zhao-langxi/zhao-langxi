---
import Layout from "../layouts/Base.astro";
import PhotoJournal from "../components/PhotoJournal.astro";
import { journalPhotos } from "../lib/photos";
import { base } from "../lib/site";
---
<Layout
  title="Days"
  description="A visual journal of IU, Indiana, and Spain days. Fourteen frames I actually took. Not a brand campaign."
  canonical="https://zhao-langxi.github.io/zhao-langxi/days.html"
  current="days"
  bodyClass="journal-page"
>
  <main id="main" tabindex="-1">
    <header>
      <p>Visual journal · IU · Indiana · Spain</p>
      <h1>The days, as they looked</h1>
      <p>
        One journal. Fourteen frames from campus walks, Kirkwood food, a lobby table, a Madrid
        sidewalk. I left out packed bars, friends who did not ask to be here, and anything that
        belongs on another door.
      </p>
    </header>
    <article>
      <section aria-labelledby="grid-heading">
        <h2 id="grid-heading">Fourteen frames</h2>
        <PhotoJournal photos={journalPhotos} variant="masonry" idPrefix="days" eagerCount={2} />
      </section>
      <p>
        <a href={`${base}iu.html`}>IU</a>
        <a href={`${base}indiana.html`}>Indiana</a>
        <a href={`${base}spain.html`}>Spain</a>
        <a href={`${base}`}>Home</a>
      </p>
    </article>
  </main>
</Layout>

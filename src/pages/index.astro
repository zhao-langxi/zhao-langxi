---
import Layout from "../layouts/Base.astro";
import FishingCat from "../components/FishingCat.astro";
import { fishingPhoto, journalPhotos } from "../lib/photos";
import { base } from "../lib/site";

function photoById(id: string) {
  const photo = journalPhotos.find((item) => item.id === id);
  if (!photo) {
    throw new Error(`Missing homepage photo: ${id}`);
  }
  return photo;
}

const placeEntries = [
  {
    href: `${base}iu.html`,
    label: "IU",
    kicker: "Campus · Bloomington",
    photo: photoById("iu-stadium-night"),
  },
  {
    href: `${base}indiana.html`,
    label: "Indiana",
    kicker: "College town · home weekends",
    photo: photoById("indiana-planter"),
  },
  {
    href: `${base}spain.html`,
    label: "Spain",
    kicker: "Study abroad · Spring 2026",
    photo: photoById("spain-residence-sun"),
  },
];
---
<Layout
  title="赵郎溪"
  description="Zhao Langxi · 赵郎溪. 小猫钓鱼, ocean light, campus days, and a small lesson about attention."
  canonical="https://zhao-langxi.github.io/zhao-langxi/"
  current="home"
  bodyClass="home"
  ogTitle="赵郎溪 · Zhao Langxi"
  ogDescription="小猫钓鱼 and a personal journal of photographs. Jade Zhao · 赵郎溪 · @zhao.langxi."
>
  <main id="main" tabindex="-1">
    <header class="home-cover">
      <img
        class="home-cover__photo"
        src={`${base}${fishingPhoto.src}`}
        alt={fishingPhoto.alt}
        width={fishingPhoto.width}
        height={fishingPhoto.height}
        decoding="async"
      />
      <div class="home-cover__copy">
        <p class="home-cover__kicker">Zhào Lángxī</p>
        <h1 lang="zh-Hans">赵郎溪</h1>
        <p class="home-cover__line">
          <span lang="zh-Hans">小猫钓鱼</span>. Sit with the water. Leave the butterfly.
        </p>
      </div>
    </header>

    <div class="ocean-band" aria-hidden="true">
      <svg viewBox="0 0 720 28" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <path class="ocean-band__wave" d="M0 16c40 8 80 8 120 0s80-8 120 0 80 8 120 0 80-8 120 0 80 8 120 0 80-8 120 0v12H0z" fill="#8ECBE8" opacity="0.45" />
        <path class="ocean-band__wave ocean-band__wave--late" d="M0 20c36 6 72 6 108 0s72-6 108 0 72 6 108 0 72-6 108 0 72 6 108 0 72-6 108 0v8H0z" fill="#3A7CA5" opacity="0.28" />
      </svg>
    </div>

    <article>
      <section class="home-places" aria-labelledby="places-heading">
        <div class="home-places__head">
          <h2 id="places-heading">The days</h2>
          <p>
            <a href={`${base}days.html`}>Fourteen frames</a>
          </p>
        </div>
        <ol class="home-places__list">
          {
            placeEntries.map((entry) => (
              <li>
                <a href={entry.href}>
                  <img
                    src={`${base}${entry.photo.src}`}
                    alt={entry.photo.alt}
                    width={entry.photo.width}
                    height={entry.photo.height}
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="essay-kicker">{entry.kicker}</span>
                  <span class="essay-title">{entry.label}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="home-story" aria-labelledby="cat-heading">
        <FishingCat size={88} title="A little cat by the water" markId="home" />
        <div>
          <h2 id="cat-heading" lang="zh-Hans">小猫钓鱼</h2>
          <p>
            The picture book, then a clearly marked analogy.
            <a href={`${base}xiao-mao-diao-yu.html`}>Open the story</a>.
          </p>
        </div>
      </section>

      <p class="quiet-links">
        <a href={`${base}about.html`}>About</a>
        <a href={`${base}archive.html`}>Writing, on hiatus</a>
      </p>
    </article>
  </main>
</Layout>

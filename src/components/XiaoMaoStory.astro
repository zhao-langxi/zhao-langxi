---
interface Props {
  idPrefix?: string;
  showFishing?: boolean;
}

const { idPrefix = "xiaomao", showFishing = false } = Astro.props;
---
<section class="xiaomao" data-xiaomao={idPrefix} aria-labelledby={`${idPrefix}-heading`}>
  <h2 id={`${idPrefix}-heading`}>小猫钓鱼 · The Little Cat Goes Fishing</h2>
  <p class="xiaomao__lede">
    A well-known Chinese children's story. One famous modern telling is by
    <span lang="zh-Hans">金近</span> (Jīn Jìn). What follows is my own retelling of the lesson,
    not a copy of any published picture book.
  </p>

  <div class="xiaomao__stage">
    <p class="xiaomao__zh" lang="zh-Hans" data-zh></p>
    <p class="xiaomao__py" data-py></p>
    <p class="xiaomao__en" data-en></p>

    <div class="xiaomao__controls">
      <button type="button" data-prev>Previous scene</button>
      <button type="button" data-next>Next scene</button>
    </div>
    <p class="xiaomao__progress">
      Scene <span data-num>1</span> of 4
    </p>
  </div>

  <blockquote class="xiaomao__lesson">
    <p lang="zh-Hans">做事要一心一意</p>
    <p>Zuò shì yào yì xīn yí yì</p>
    <p>When you do something, give it your full attention.</p>
  </blockquote>

  {showFishing && (
    <div class="xiaomao__fish-game" data-fish-game>
      <h3>A small fishing practice</h3>
      <p>
        The lesson is patience. Cast the line, then wait. If you chase a butterfly, the fish slips away.
      </p>
      <p class="xiaomao__status" data-fish-status aria-live="polite">The water is quiet. Cast when you are ready.</p>
      <div class="xiaomao__controls">
        <button type="button" data-cast>Cast the line</button>
        <button type="button" data-butterfly>Chase a butterfly</button>
      </div>
    </div>
  )}
</section>

<script>
  type Scene = { zh: string; py: string; en: string };

  const scenes: Scene[] = [
    {
      zh: "猫妈妈带着小猫去河边钓鱼。",
      py: "Māo māma dàizhe xiǎo māo qù hébiān diào yú.",
      en: "Mother Cat takes Little Cat to the river to fish.",
    },
    {
      zh: "一只蝴蝶飞来。小猫放下鱼竿，追了过去。",
      py: "Yì zhī húdié fēi lái. Xiǎo māo fàngxià yúgān, zhuī le guòqù.",
      en: "A butterfly passes. Little Cat drops the rod and runs after it.",
    },
    {
      zh: "猫妈妈说：做事要一心一意。",
      py: "Māo māma shuō: zuò shì yào yì xīn yí yì.",
      en: "Mother Cat says: when you do a thing, give it your whole heart.",
    },
    {
      zh: "小猫坐下。水静了。鱼来了。",
      py: "Xiǎo māo zuò xià. Shuǐ jìng le. Yú lái le.",
      en: "Little Cat sits. The water stills. A fish comes.",
    },
  ];

  function initStory(root: HTMLElement) {
    let index = 0;
    const zh = root.querySelector("[data-zh]");
    const py = root.querySelector("[data-py]");
    const en = root.querySelector("[data-en]");
    const num = root.querySelector("[data-num]");
    const prev = root.querySelector("[data-prev]");
    const next = root.querySelector("[data-next]");

    function render() {
      const scene = scenes[index];
      if (zh) zh.textContent = scene.zh;
      if (py) py.textContent = scene.py;
      if (en) en.textContent = scene.en;
      if (num) num.textContent = String(index + 1);
      if (prev instanceof HTMLButtonElement) prev.disabled = index === 0;
      if (next instanceof HTMLButtonElement) next.disabled = index === scenes.length - 1;
    }

    prev?.addEventListener("click", () => {
      index = Math.max(0, index - 1);
      render();
    });
    next?.addEventListener("click", () => {
      index = Math.min(scenes.length - 1, index + 1);
      render();
    });

    render();
  }

  function initFishing(root: HTMLElement) {
    const status = root.querySelector("[data-fish-status]");
    const cast = root.querySelector("[data-cast]");
    const butterfly = root.querySelector("[data-butterfly]");
    let waiting = false;
    let timer: number | undefined;

    function reset(message: string) {
      waiting = false;
      window.clearTimeout(timer);
      if (status) status.textContent = message;
    }

    cast?.addEventListener("click", () => {
      if (waiting) return;
      waiting = true;
      if (status) status.textContent = "The line is in. Sit with it. Do not chase the butterfly.";
      timer = window.setTimeout(() => {
        waiting = false;
        if (status) status.textContent = "A fish. Patience did the work.";
      }, 4000);
    });

    butterfly?.addEventListener("click", () => {
      reset("The butterfly wins, the fish leaves. Cast again when you can stay.");
    });
  }

  document.querySelectorAll<HTMLElement>("[data-xiaomao]").forEach((root) => {
    initStory(root);
    const game = root.querySelector<HTMLElement>("[data-fish-game]");
    if (game) initFishing(game);
  });
</script>

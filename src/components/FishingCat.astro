---
interface Props {
  size?: number;
  title?: string;
}

const { size = 56, title = "A little fishing cat" } = Astro.props;
---
<svg
  class="fishing-cat"
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role="img"
  aria-labelledby="fishing-cat-title"
>
  <title id="fishing-cat-title">{title}</title>
  <ellipse cx="32" cy="52" rx="18" ry="4" fill="#8ECBE8" opacity="0.45" />
  <path d="M20 28c0-10 6-18 12-18s12 8 12 18-5 16-12 16-12-6-12-16z" fill="#F7F0E6" stroke="#254B70" stroke-width="1.4" />
  <path d="M22 16l-4-8 8 4M42 16l4-8-8 4" fill="#F7F0E6" stroke="#254B70" stroke-width="1.4" stroke-linejoin="round" />
  <circle cx="28" cy="26" r="1.4" fill="#254B70" />
  <circle cx="36" cy="26" r="1.4" fill="#254B70" />
  <path d="M30 31h4" stroke="#254B70" stroke-width="1.2" stroke-linecap="round" />
  <path d="M44 22c8-2 14 6 12 12" fill="none" stroke="#254B70" stroke-width="1.3" stroke-linecap="round" />
  <path d="M56 34v10" stroke="#254B70" stroke-width="1.2" />
  <path d="M54 46c2 2 4 2 6 0" fill="none" stroke="#3A7CA5" stroke-width="1.2" />
</svg>

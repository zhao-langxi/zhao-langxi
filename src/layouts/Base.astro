---
import "../styles/rivet.css";
import { base } from "../lib/site";
const {
  title,
  description,
  canonical,
  lang = "en-GB",
  current = "",
  ogTitle = title,
  ogDescription = description,
  ogImageAlt = "Jade Zhao fishing on a boat · zhao-langxi",
  robots = "index, follow",
  skipLabel = "Skip to main content",
} = Astro.props;

const pageTitle = title.includes("zhao-langxi") ? title : `${title} · zhao-langxi`;
const canonicalUrl = canonical ?? `https://zhao-langxi.github.io${Astro.url.pathname}`;
const ogImage = "https://zhao-langxi.github.io/zhao-langxi/og-image.jpg";
const navItems = [
  { id: "home", href: base, label: "Home" },
  { id: "xiaomao", href: `${base}xiao-mao-diao-yu.html`, label: "小猫钓鱼" },
  { id: "iu", href: `${base}iu.html`, label: "IU" },
  { id: "indiana", href: `${base}indiana.html`, label: "Indiana" },
  { id: "spain", href: `${base}spain.html`, label: "Spain" },
  { id: "days", href: `${base}days.html`, label: "Days" },
  { id: "about", href: `${base}about.html`, label: "About" },
];
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content={robots} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="author" content="Jade Zhao" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="zhao-langxi · Jade Zhao" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16x16.png`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}favicon-192x192.png`} />
    <link rel="icon" type="image/png" sizes="512x512" href={`${base}favicon-512x512.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <meta name="theme-color" content="#EAF7FF" />
  </head>
  <body class:list={["site", Astro.props.bodyClass]}>
    <a class="skip-link" href="#main">{skipLabel}</a>
    <header class="mast">
      <nav aria-label={lang === "zh-Hans" ? "站点导航" : "Site"}>
        <a class="mast-mark" aria-label="赵郎溪, home" href={base}><span lang="zh-Hans">赵郎溪</span></a>
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} aria-current={current === item.id ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <span class="contrast">
          <input class="high-contrast-control" id="high-contrast" type="checkbox" />
          <label class="theme-toggle" for="high-contrast">High contrast</label>
        </span>
      </nav>
    </header>
    <slot />
    <footer>
      <div>
        <p class="footer-mark"><span lang="zh-Hans">赵郎溪</span> · Jade Zhao · <a href="https://www.instagram.com/zhao.langxi" rel="noopener noreferrer">@zhao.langxi</a></p>
        <nav aria-label={lang === "zh-Hans" ? "其他站点" : "Other doors"}>
          <a href="https://jadexzhao.github.io/jadexzhao/" rel="noopener noreferrer">jadexzhao</a>
          <a href="https://matchaxmoxie.github.io/matchaxmoxie/" rel="noopener noreferrer">matchaxmoxie</a>
          <a aria-current="page" href="https://zhao-langxi.github.io/zhao-langxi/">zhao-langxi</a>
        </nav>
        <p class="footer-note">
          {
            lang === "zh-Hans"
              ? "个人生活笔记。不是招生简章，也不是印第安纳大学背书。"
              : "A personal journal. Not an admissions brochure, and not IU-endorsed."
          }
          {" "}
          <a href={`${base}archive.html`}>Older writing, on hiatus</a>.
        </p>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var box = document.getElementById("high-contrast");
        if (!box) return;
        try {
          box.checked = window.localStorage.getItem("zhao-langxi-contrast") === "on";
        } catch (err) {}
        box.addEventListener("change", function () {
          try {
            window.localStorage.setItem("zhao-langxi-contrast", box.checked ? "on" : "off");
          } catch (err) {}
        });
      })();
    </script>
  </body>
</html>
